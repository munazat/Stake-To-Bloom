{
  "name": "bloomstake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bloomstake/web",
    "build": "npm run build --workspace @bloomstake/web",
    "preview": "npm run preview --workspace @bloomstake/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sync-core": "node scripts/sync-core.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
