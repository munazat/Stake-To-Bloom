# ==============================================================================
# BloomStake environment template. Copy the values you need into a local .env
# (never committed) or set them as Supabase secrets. NEVER put real secrets here.
# ==============================================================================

# ---- Web build (public by design, safe to expose in the browser) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_APP_ENV=sandbox
# Local development only: 'mock' replaces PayPal with a stand-in. A production build refuses it.
VITE_PAYMENTS_ADAPTER=

# ---- Supabase Edge Function secrets -----------------------------------------
# Set with: supabase secrets set KEY=VALUE   (never in git)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CHARITY_EMAIL=
# Optional payee check on every capture (invariant I3). Set either or both.
PAYPAL_MERCHANT_ID=
PAYPAL_BUSINESS_EMAIL=
# Local development only: 'mock' fakes PayPal. Functions refuse it on a hosted project.
PAYMENTS_ADAPTER=

GEMINI_API_KEY=
# Comma-separated, best first. Prefer GA (non-preview) models. Print a working chain with:
#   node scripts/probe-gemini.mjs
GEMINI_MODEL_CHAIN=
AI_DAILY_CAP_USER=8
AI_DAILY_CAP_GLOBAL=300

# Generate with: openssl rand -hex 32
ADMIN_SECRET=
CRON_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

# ---- GitHub Actions secrets (set in the repo settings, not here) -------------
# CRON_SECRET
# SUPABASE_PROJECT_URL
